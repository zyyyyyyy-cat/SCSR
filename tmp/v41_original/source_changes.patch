+
+class AttentionInputBlock(Block):
+    """Only blocks[6] uses this subclass; its original residual is untouched."""
+
+    def forward(self, x, token_modulator=None, modal_ids=None, observer=None):
+        if token_modulator is None and observer is None:
+            return super().forward(x)
+        z = self.norm1(x)
+        updated = token_modulator(z, modal_ids) if token_modulator is not None else z
+        attention = self.attn(updated)
+        if observer is not None:
+            observer('block7_norm1', z)
+            observer('block7_attention_input', updated)
+            observer('block7_attention_output', attention)
+        x = x + self.drop_path(attention)
         x = x + self.drop_path(self.mlp(self.norm2(x)))
         return x
 
